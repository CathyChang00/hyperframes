    "generated_repairs": "Only explicitly requested local regions; preserve identity and protected original pixels"
  },
  "signature_start": {
    "left_ratio": 0.19333333333333333,
    "width_ratio": 0.7546666666666667,
    "bottom_ratio": 0.898,
    "lock_after_UI_check": true,
    "height": "Derived from group aspect ratio; align visible bottom across series",
